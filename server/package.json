{
  "name": "@rpg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:bufferutil --external:utf-8-validate --outfile=dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@rpg/shared": "0.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.3"
  }
}
